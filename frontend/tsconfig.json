{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  // La configuración también se comprueba: un error de tipos en
  // `tailwind.config.ts` (un token mal escrito, una clave que ya no existe)
  // rompía el diseño sin que `tsc --noEmit` dijera nada.
  "include": ["src", "vite.config.ts", "tailwind.config.ts"]
}
