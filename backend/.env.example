# === Aplicación ===
NODE_ENV=development
PORT=3000

# === Base de datos (PostgreSQL) ===
# Coincide con las credenciales de docker-compose.yml para desarrollo local
DATABASE_URL="postgresql://whatsflow:whatsflow_dev@localhost:5432/whatsflow?schema=public"

# === Redis (colas BullMQ) ===
REDIS_HOST=localhost
REDIS_PORT=6379

# === Autenticación ===
# Genera un secreto fuerte para producción: `openssl rand -base64 48`
JWT_SECRET=cambia_esto_por_un_secreto_fuerte_en_produccion
JWT_EXPIRES_IN=1d

# === Canal de WhatsApp ===
# Qué proveedor transporta los mensajes. Cambiar esto es TODO lo que hace falta
# para migrar: 'evolution' (puente del MVP, se vincula escaneando un QR) o
# 'meta' (Cloud API oficial). Ver src/whatsapp/providers/.
WHATSAPP_PROVIDER=evolution

# --- Evolution API (activo hoy) ---
# Servidor de Evolution: https://github.com/evolution-foundation/evolution-api
EVOLUTION_API_URL=http://localhost:8080
# La AUTHENTICATION_API_KEY del servidor de Evolution (clave global)
EVOLUTION_API_KEY=
# Origen público de ESTE backend. Evolution tiene que poder alcanzarlo para
# entregar los webhooks: si corre en Docker, "localhost" apunta a su propio
# contenedor — usa http://host.docker.internal:3000 o un túnel (ngrok).
BACKEND_PUBLIC_URL=http://localhost:3000
# Secreto que Evolution devolverá en cada webhook (cabecera Authorization).
# Evolution NO firma sus payloads como Meta, así que esto es lo único que separa
# un evento legítimo de cualquiera que descubra la ruta: sin él el webhook queda
# cerrado. Genera uno con `openssl rand -hex 32`.
EVOLUTION_WEBHOOK_TOKEN=

# --- Meta Cloud API (destino final) ---
# Se obtienen al registrar la app en https://developers.facebook.com
WHATSAPP_VERIFY_TOKEN=token_de_verificacion_del_webhook
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# === IA (Claude / Anthropic) ===
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Guarda de costo (NFR): máximo de llamadas a la IA por conversación en la ventana
AI_MAX_CALLS_PER_CONVERSATION_PER_HOUR=20
