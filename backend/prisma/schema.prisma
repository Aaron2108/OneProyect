// WhatsFlow AI — esquema de datos del MVP (Fase 1)
// Multi-tenancy: esquema compartido, `tenantId` en todas las tablas de negocio.
// Sin pgvector en el MVP (memoria vectorial diferida a Fase 4, ver docs/DECISIONS.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  OWNER
  AGENT
}

enum MessageDirection {
  INBOUND // del cliente final hacia la empresa
  OUTBOUND // de la empresa/IA hacia el cliente final
}

enum MessageSender {
  CONTACT // lo escribió el cliente final
  AI // lo generó el agente de IA
  HUMAN // lo escribió un miembro del equipo
}

// Quién atiende la conversación (RF-11: handoff humano)
enum ConversationHandler {
  AI
  HUMAN
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ReminderStatus {
  PENDING
  SENT
  CANCELLED
}

// RF-12: opt-in del contacto
enum ConsentStatus {
  GRANTED
  DENIED
  UNKNOWN
}

// Estado de un documento de conocimiento del negocio (ver KnowledgeDocument).
// El dueño confirma el texto extraído (PENDING_REVIEW -> ACTIVE) antes de que la
// IA lo use: así nunca responde con contenido que el negocio no revisó.
enum KnowledgeDocumentStatus {
  EXTRACTING // subido, extrayendo texto
  PENDING_REVIEW // texto extraído, esperando confirmación del dueño
  ACTIVE // confirmado: la IA lo usa para responder
  FAILED // no se pudo extraer texto legible (ver extractionError)
}

// Cómo se obtuvo el texto del documento — se muestra en el panel porque cambia
// la confianza en el resultado y, en el caso de VISION, tiene un costo en tokens.
enum KnowledgeExtractionMethod {
  TEXT_LAYER // texto nativo del archivo (gratis)
  VISION // PDF escaneado transcrito por la visión de Claude (cuesta tokens)
}

// ---------------------------------------------------------------------------
// Modelos
// ---------------------------------------------------------------------------

model Tenant {
  id                    String   @id @default(uuid())
  name                  String
  // ID del número de WhatsApp en Meta — enruta cada webhook entrante a su tenant
  whatsappPhoneNumberId String?  @unique @map("whatsapp_phone_number_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  users                     User[]
  contacts                  Contact[]
  conversations             Conversation[]
  appointments              Appointment[]
  reminders                 Reminder[]
  quickReplies              QuickReply[]
  googleCalendarIntegration GoogleCalendarIntegration?
  googleCalendarSyncJobs    GoogleCalendarSyncJob[]
  aiContextMemories         AiContextMemory[]
  businessProfile           BusinessProfile?
  knowledgeDocuments        KnowledgeDocument[]
  products                  Product[]

  @@map("tenants")
}

// Contexto del negocio que el propietario le da a la IA (apartado "Agente IA"
// del panel): horarios, servicios, políticas, tono e instrucciones libres. Sin
// esto, la IA solo sabía el nombre del tenant — no podía responder nada
// específico del negocio (ver docs/DECISIONS.md, 2026-07-23). Se inyecta
// completo en el system prompt (AiService.buildSystemPrompt); campos acotados
// en longitud para no inflar el prompt sin límite.
model BusinessProfile {
  id                 String   @id @default(uuid())
  tenantId           String   @unique @map("tenant_id")
  businessHours      String?  @map("business_hours")
  services           String?
  policies           String?
  tone               String?
  customInstructions String?  @map("custom_instructions")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("business_profiles")
}

// Fase 3 (integraciones): conexión de UN calendario de Google por tenant (lo
// conecta el OWNER). Sincronización de una sola vía (WhatsFlow → Google) — ver
// docs/DECISIONS.md. Tokens cifrados en reposo (AES-256-GCM, ver
// src/common/crypto.util.ts); nunca se guardan en claro.
model GoogleCalendarIntegration {
  id                   String   @id @default(uuid())
  tenantId             String   @unique @map("tenant_id")
  googleAccountEmail   String   @map("google_account_email")
  googleCalendarId     String   @default("primary") @map("google_calendar_id")
  accessToken          String   @map("access_token") // cifrado
  refreshToken         String   @map("refresh_token") // cifrado
  accessTokenExpiresAt DateTime @map("access_token_expires_at")
  connectedByUserId    String   @map("connected_by_user_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("google_calendar_integrations")
}

// Cola de reintentos para la sincronización con Google Calendar: si crear/
// actualizar/borrar el evento falla (red, token, rate limit de Google), en vez
// de abandonar en silencio se guarda aquí con backoff exponencial. Un job por
// cita (@unique) — cada intento reconcilia el estado completo de la cita, así
// que no hace falta encolar más de uno a la vez. Ver GoogleCalendarSyncService.
model GoogleCalendarSyncJob {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  appointmentId String   @unique @map("appointment_id")
  attempts      Int      @default(0)
  nextAttemptAt DateTime @map("next_attempt_at")
  lastError     String?  @map("last_error")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([nextAttemptAt])
  @@map("google_calendar_sync_jobs")
}

// Respuestas rápidas: plantillas de mensaje reutilizables del equipo.
model QuickReply {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  title     String
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("quick_replies")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  // Único a nivel global (no solo por tenant): el login por email sería
  // ambiguo si el mismo email existiera en dos tenants (ver auth.service.ts).
  // Antes solo se exigía en el código de la aplicación (`findFirst` +
  // `create`, con una ventana de condición de carrera); ahora también lo
  // exige la base de datos.
  email        String   @unique
  // Nulo si la cuenta se creó con "Continuar con Google" y nunca puso una
  // contraseña propia (ver auth/google-auth.service.ts) — no reemplaza al login
  // por contraseña, es una alternativa.
  passwordHash String?  @map("password_hash")
  // `sub` de Google (identificador estable de la cuenta), si se vinculó.
  googleId     String?  @unique @map("google_id")
  name         String
  role         UserRole @default(AGENT)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("users")
}

model Contact {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  phone     String // número de WhatsApp del cliente final (E.164)
  name      String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations     Conversation[]
  appointments      Appointment[]
  reminders         Reminder[]
  consent           ContactConsent?
  aiContextMemories AiContextMemory[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@map("contacts")
}

model Conversation {
  id             String              @id @default(uuid())
  tenantId       String              @map("tenant_id")
  contactId      String              @map("contact_id")
  status         ConversationStatus  @default(OPEN)
  handledBy      ConversationHandler @default(AI) @map("handled_by") // RF-11: quién responde ahora
  // Contador denormalizado de mensajes entrantes sin leer por el equipo: lo
  // incrementa el worker al recibir un entrante y se pone a 0 al abrir el hilo.
  // Denormalizado para no recalcularlo en cada listado (escala).
  unreadCount    Int                 @default(0) @map("unread_count")
  // RF-10: la ventana de 24h se calcula desde el último mensaje entrante
  lastInboundAt  DateTime?           @map("last_inbound_at")
  lastMessageAt  DateTime?           @map("last_message_at")
  // Fase 4 (seguimiento automático): cuántos seguimientos automáticos van
  // enviados desde que el contacto respondió por última vez (se resetea a 0
  // en cada entrante — ver InboundMessageProcessor) y cuándo se envió el
  // último. Ver ConversationFollowUpService.
  followUpCount  Int                 @default(0) @map("follow_up_count")
  lastFollowUpAt DateTime?           @map("last_follow_up_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact  Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages Message[]
  notes    ConversationNote[]

  @@index([tenantId])
  @@index([tenantId, contactId])
  @@index([tenantId, status, lastMessageAt])
  @@map("conversations")
}

// Notas internas del equipo sobre una conversación (privadas, no se envían al cliente).
model ConversationNote {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  conversationId String   @map("conversation_id")
  authorId       String   @map("author_id")
  authorName     String   @map("author_name") // denormalizado para que el nombre sobreviva
  body           String
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("conversation_notes")
}

model Message {
  id                String           @id @default(uuid())
  tenantId          String           @map("tenant_id")
  conversationId    String           @map("conversation_id")
  direction         MessageDirection
  sender            MessageSender
  // ID del mensaje en Meta — único por tenant para deduplicar reenvíos (guarda NFR)
  whatsappMessageId String?          @map("whatsapp_message_id")
  type              String           @default("text") // text | template | image | ...
  content           String
  createdAt         DateTime         @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, whatsappMessageId])
  @@index([conversationId, createdAt])
  @@map("messages")
}

model Appointment {
  id            String            @id @default(uuid())
  tenantId      String            @map("tenant_id")
  contactId     String            @map("contact_id")
  title         String
  scheduledAt   DateTime          @map("scheduled_at")
  status        AppointmentStatus @default(SCHEDULED)
  notes         String?
  // ID del evento en Google Calendar si el tenant tiene la integración conectada
  // (Fase 3); null si no está sincronizada o si el tenant no la usa.
  googleEventId String?           @map("google_event_id")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact               Contact                @relation(fields: [contactId], references: [id], onDelete: Cascade)
  reminders             Reminder[]
  googleCalendarSyncJob GoogleCalendarSyncJob?

  @@index([tenantId])
  @@index([tenantId, scheduledAt])
  @@map("appointments")
}

model Reminder {
  id            String         @id @default(uuid())
  tenantId      String         @map("tenant_id")
  contactId     String         @map("contact_id")
  appointmentId String?        @map("appointment_id")
  message       String
  remindAt      DateTime       @map("remind_at")
  status        ReminderStatus @default(PENDING)
  // Origen del recordatorio, para distinguirlo en el panel de uno creado a
  // mano/por tool-calling de la IA en una cita. Null = manual/vía IA (como
  // hasta ahora); "auto-followup" = generado por ConversationFollowUpService
  // (Fase 4, seguimiento automático sin intervención humana).
  source        String?
  // Despacho a prueba de concurrencia/escala: `nextAttemptAt` actúa como lease
  // (claim atómico entre instancias) y como backoff; `attempts` cuenta los
  // envíos fallidos para acotar reintentos. Ver ReminderDispatchService.
  attempts      Int            @default(0)
  nextAttemptAt DateTime?      @map("next_attempt_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact     Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([status, remindAt])
  @@index([status, nextAttemptAt])
  @@map("reminders")
}

// RF-12: consentimiento (opt-in) del contacto para recibir mensajes
model ContactConsent {
  id        String        @id @default(uuid())
  tenantId  String        @map("tenant_id")
  contactId String        @unique @map("contact_id")
  status    ConsentStatus @default(UNKNOWN)
  source    String? // cómo se obtuvo el opt-in (ej. "primer mensaje entrante")
  grantedAt DateTime?     @map("granted_at")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("contact_consent")
}

// Fase 4 (IA y automatizaciones): memoria de contexto entre conversaciones,
// por contacto. Se guarda un resumen (generado por la IA al cerrar una
// conversación, ver ConversationsService) junto con su embedding; al
// responder, la IA recupera los resúmenes más similares al mensaje actual del
// mismo contacto (nunca cruza tenants ni contactos) — así recuerda algo más
// allá de la ventana de contexto de la conversación en curso. Ver
// docs/DECISIONS.md (2026-07-23).
//
// `embedding` es `Unsupported` porque Prisma Client no representa el tipo
// `vector` de pgvector: se inserta/consulta con SQL crudo
// (AiContextMemoryService), nunca con el Prisma Client normal. `content` se
// cifra en reposo igual que Message.content/ConversationNote.body (PII).
model AiContextMemory {
  id             String                       @id @default(uuid())
  tenantId       String                       @map("tenant_id")
  contactId      String                       @map("contact_id")
  conversationId String?                      @map("conversation_id")
  content        String // resumen cifrado (AES-256-GCM, ver common/pii-crypto.service.ts)
  // Opcional: puede estar sin vector mientras espera reindexado (ver la
  // migración `embeddings_1024`). El recall descarta las filas sin vector.
  embedding      Unsupported("vector(1024)")?
  createdAt      DateTime                     @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([tenantId, contactId])
  @@map("ai_context_memory")
}

// Documentos que el negocio sube para que la IA conozca su operación (PDF con
// texto, PDF escaneado, Word, texto plano/Markdown). A diferencia de
// AiContextMemory —que es memoria POR CONTACTO— este conocimiento es DEL TENANT:
// aplica a cualquier conversación, así que necesita su propia tabla en vez de
// reutilizar `ai_context_memory` (cuyo `contact_id` es obligatorio).
//
// Deliberadamente NO guarda el archivo original, solo el texto extraído: la IA
// nunca necesita el binario y no almacenarlo reduce la superficie de datos en
// reposo. El nombre se conserva para que el dueño reconozca qué subió.
model KnowledgeDocument {
  id               String                     @id @default(uuid())
  tenantId         String                     @map("tenant_id")
  filename         String
  mimeType         String                     @map("mime_type")
  sizeBytes        Int                        @map("size_bytes")
  status           KnowledgeDocumentStatus    @default(EXTRACTING)
  extractionMethod KnowledgeExtractionMethod? @map("extraction_method")
  pageCount        Int?                       @map("page_count")
  // Caracteres del texto extraído — el panel lo usa para estimar cuánto pesa
  // este documento en el contexto de la IA.
  charCount        Int?                       @map("char_count")
  // Tokens gastados si hizo falta transcribir con visión (0 en TEXT_LAYER).
  // Es un costo de una sola vez al subir, no por cada mensaje de WhatsApp.
  visionTokensUsed Int                        @default(0) @map("vision_tokens_used")
  // Motivo legible cuando status = FAILED (p. ej. PDF escaneado ilegible).
  extractionError  String?                    @map("extraction_error")
  createdAt        DateTime                   @default(now()) @map("created_at")
  updatedAt        DateTime                   @updatedAt @map("updated_at")

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chunks KnowledgeChunk[]

  @@index([tenantId, status])
  @@map("knowledge_documents")
}

// Fragmento de un documento con su embedding, para recuperar por similitud solo
// lo relevante a la pregunta del cliente en vez de inyectar el documento entero
// en cada mensaje (el system prompt se paga en CADA mensaje — ver
// docs/DECISIONS.md). Mismo patrón que AiContextMemory: `embedding` es
// `Unsupported` y se maneja con SQL crudo parametrizado; `content` va cifrado.
model KnowledgeChunk {
  id         String                       @id @default(uuid())
  tenantId   String                       @map("tenant_id")
  documentId String                       @map("document_id")
  // Posición dentro del documento — permite mostrar los fragmentos en orden.
  position   Int
  content    String // fragmento cifrado (AES-256-GCM, ver common/pii-crypto.service.ts)
  // Opcional: el texto pendiente de revisión (posición -1) no se indexa, y un
  // fragmento puede estar sin vector mientras espera reindexado.
  embedding  Unsupported("vector(1024)")?

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([documentId])
  @@map("knowledge_chunks")
}

// Catálogo de productos del negocio. A diferencia de la documentación
// (`KnowledgeDocument`), el stock NO se resuelve inyectando un archivo en el
// prompt: un PDF o un CSV es una foto de un momento, y la IA acabaría
// prometiendo existencias que ya no hay. La IA lo consulta en vivo con la
// herramienta `consultar_producto` (tool-calling contra esta tabla), igual que
// hace con las citas. Ver docs/DECISIONS.md.
model Product {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  // Código del negocio. Es la clave con la que la importación actualiza en vez
  // de duplicar; opcional porque muchos negocios pequeños no lo usan.
  sku         String?
  name        String
  description String?
  // Precio en la unidad mínima de la moneda (céntimos) y como entero: en dinero,
  // el punto flotante arrastra errores de redondeo.
  priceCents  Int?     @map("price_cents")
  // Moneda ISO-4217 si el negocio la indicó. Opcional a propósito: no se inventa
  // una moneda que el propietario no haya declarado.
  currency    String?
  stock       Int      @default(0)
  // Un producto descatalogado se desactiva en vez de borrarse, para no perder el
  // histórico; la IA solo ve los activos.
  active      Boolean  @default(true)
  // Nombre + SKU + descripción en minúsculas y sin tildes, denormalizado en cada
  // escritura por `ProductsService`. El cliente escribe "pantalon" desde el móvil
  // y el producto se llama "Pantalón": buscar sobre las columnas originales le
  // hacía responder al agente que no existía. Ver docs/DECISIONS.md.
  searchText  String   @default("") @map("search_text")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sku])
  @@index([tenantId, active])
  // GIN de trigramas: acelera el `LIKE '%…%'` de la búsqueda y habilita la
  // tolerancia a erratas (`<%` / `word_similarity`). Requiere `pg_trgm`.
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("products")
}
